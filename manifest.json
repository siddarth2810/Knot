{
  "manifest_version": 3,
  "name": "Knot – Clip & Blog to Markdown",
  "version": "0.2.0",
  "description": "Clip highlights or build multi-site Markdown dossiers for Obsidian.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "contextMenus", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Knot",
    "default_popup": "popup.html"
  },
  "commands": {
    "open-clipper": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open clipper panel on page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
